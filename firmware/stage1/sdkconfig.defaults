CONFIG_IDF_TARGET="esp32s3"
# Built for 8 MB flash so it matches Rev A's PICO-1-N8R8
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Logs over the DevKit's native "USB" port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
# Read-only FAT image in flash for test audio (flash_data/)
CONFIG_FATFS_LFN_HEAP=y
# Player (as Stage 0): main task builds the first folder listing
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# 8 MB octal PSRAM on the N8R8 (same as Rev A's PICO-1-N8R8). Uses GPIO 33-37.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Keep internal RAM for DMA/audio; malloc() above this size goes to PSRAM
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
